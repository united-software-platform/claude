# Профиль аккаунта Claude: каталог внутри CLAUDE_ACCOUNTS_DIR. Обязателен —
# без него compose не соберёт путь к каталогу аккаунта и остановится с ошибкой
CLAUDE_PROFILE=personal

# Каталог проекта внутри контейнера
PROJECT_DIR=/app

# Профили аккаунтов: каталог на хосте и путь конфига внутри контейнера
CLAUDE_ACCOUNTS_DIR=.claude-accounts
CLAUDE_CONFIG_DIR=/home/claude/.claude

# SSH-ключи: каталог на хосте и точка монтирования в контейнере
SSH_DIR=.ssh
CONTAINER_SSH_DIR=/home/claude/.ssh

# UID/GID пользователя claude и версия Claude Code задаются только при локальной
# сборке образа — это build-arg команды docker build, а не переменные запуска:
# docker build -f docker/claude/Dockerfile \
#   --build-arg USER_ID="$(id -u)" --build-arg GROUP_ID="$(id -g)" \
#   --build-arg CLAUDE_CODE_VERSION=latest -t usp-claude:local .
