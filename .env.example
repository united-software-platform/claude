# Образ агента: тег локальный и свой у каждого проекта, иначе проекты перетирают образ друг друга.
# Готовый образ из GHCR указывается здесь же: IMAGE=ghcr.io/united-software-platform/claude:latest
IMAGE=usp-claude:latest

# Каталог проекта внутри контейнера
PROJECT_DIR=/app

# Версия Claude Code при локальной сборке: latest или конкретный номер (например 2.1.234)
CLAUDE_CODE_VERSION=latest

# Профили аккаунтов: каталог на хосте и путь конфига внутри контейнера
CLAUDE_ACCOUNTS_DIR=.claude-accounts
CLAUDE_CONFIG_DIR=/home/claude/.claude

# SSH-ключи: каталог на хосте и точка монтирования в контейнере
SSH_DIR=.ssh
CONTAINER_SSH_DIR=/home/claude/.ssh

# UID/GID пользователя claude в образе — задайте свои значения (id -u, id -g),
# иначе созданные агентом файлы окажутся чужими
USER_ID=1000
GROUP_ID=1000
